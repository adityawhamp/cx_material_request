<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- TREE -->
        <record id="material_request_view_tree" model="ir.ui.view">
            <field name="name">material.request.view.tree</field>
            <field name="model">amp.material.request</field>
            <field name="arch" type="xml">
                <list name="Material Request">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- FORM -->
        <record id="material_request_view_form" model="ir.ui.view">
            <field name="name">material.request.view.form</field>
            <field name="model">amp.material.request</field>
            <field name="arch" type="xml">
                <form name="Material Request">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <field name="x_required_date"/>
                            <field name="x_requester_user_id" readonly="1"/>
                        </group>
                        <notebook>
                            <page name="request_line_tab" string="Request Line(s)">
                                <field name="x_line_ids">
                                    <list string="Line(s)" editable="top">
                                        <field name="x_product_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                        <field name="x_uom_id"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- SEARCH -->
        <record id="material_request_search" model="ir.ui.view">
            <field name="name">material.request.search</field>
            <field name="model">amp.material.request</field>
            <field name="arch" type="xml">
                <search string="Material Request">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="material_request_action" model="ir.actions.act_window">
            <field name="name">Material Request</field>
            <field name="res_model">amp.material.request</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="material_request_search"/>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="path">material-request</field>
        </record>

        <!-- MENU -->
         <menuitem id="material_request_root_menu"
                   name="Material Request"
                   sequence="400"
                   groups="group_material_request_user"/>

        <menuitem id="material_request_operations_menu"
                  name="Operations"
                  parent="material_request_root_menu"
                  sequence="1"/>

        <menuitem id="material_request_menu"
                  name="Material Request"
                  action="material_request_action"
                  parent="material_request_operations_menu"
                  sequence="1"/>
    </data>
</odoo>