<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- TREE -->
        <record id="material_request_view_tree" model="ir.ui.view">
            <field name="name">material.request.view.tree</field>
            <field name="model">amp.material.request</field>
            <field name="arch" type="xml">
                <list name="Material Request">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <!-- FORM -->
        <record id="material_request_view_form" model="ir.ui.view">
            <field name="name">material.request.view.form</field>
            <field name="model">amp.material.request</field>
            <field name="arch" type="xml">
                <form name="Material Request">
                    <header>
                        <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="status != 'draft'"/>
                        <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="status != 'open'"/>
                        <button name="action_create_picking" type="object" string="Create Picking" class="oe_highlight" invisible="status in ('draft', 'done', 'close')"/>
                        <field name="status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object" name="action_view_picking" class="oe_stat_button" icon="fa-truck" invisible="x_picking_count == 0">
                                <field name="x_picking_count" widget="statinfo" string="Transfer(s)" help="Transfer(s)"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="x_required_date" readonly="status != 'draft'"/>
                                <field name="x_requester_user_id" readonly="1" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            </group>
                            <group>
                                <field name="x_type" readonly="status != 'draft'"/>
                                <field name="x_consume_type" invisible="x_type != 'consumption'" readonly="status != 'draft'"/>
                            </group>
                            <group>
                                <field name="x_src_location_id" domain="[('usage', '=', 'internal')]" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                       readonly="status != 'draft'"/>
                                <field name="x_dest_location_id" domain="[('usage', '=', 'internal')]" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                       readonly="status != 'draft'"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="request_line_tab" string="Request Line(s)">
                                <field name="x_line_ids" readonly="status != 'draft'">
                                    <list string="Line(s)" editable="top">
                                        <field name="x_product_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                        <field name="x_uom_id"/>
                                        <field name="x_req_qty"/>
                                        <field name="x_processed_qty"/>
                                        <field name="x_done_qty"/>
                                        <field name="x_outstanding_qty"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- SEARCH -->
        <record id="material_request_search" model="ir.ui.view">
            <field name="name">material.request.search</field>
            <field name="model">amp.material.request</field>
            <field name="arch" type="xml">
                <search string="Material Request">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="material_request_action" model="ir.actions.act_window">
            <field name="name">Material Request</field>
            <field name="res_model">amp.material.request</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="material_request_search"/>
            <field name="context">{}</field>
            <field name="domain">[]</field>
            <field name="path">material-request</field>
        </record>

        <!-- MENU -->
         <menuitem id="material_request_root_menu"
                   name="Material Request"
                   sequence="400"
                   groups="group_material_request_user"/>

        <menuitem id="material_request_operations_menu"
                  name="Operations"
                  parent="material_request_root_menu"
                  sequence="1"/>

        <menuitem id="material_request_menu"
                  name="Material Request"
                  action="material_request_action"
                  parent="material_request_operations_menu"
                  sequence="1"/>
    </data>
</odoo>